ADDR=:8080
DATABASE_URL=postgres://kyo:tientda1@localhost:5432/first_db?sslmode=disable

# bcrypt cost. 12 là mức tối thiểu hợp lý cho production (tăng cost = chậm hơn, an toàn hơn).
BCRYPT_COST=12

SESSION_TTL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Rate limit tính theo phút, burst là số request được phép dồn cục.
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_BURST=5
